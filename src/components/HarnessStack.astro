---
import type { Project } from '../data/projects';
import { harnessGroup } from '../data/harness';
import CornerMarks from './CornerMarks.astro';
import { withBase } from '../utils/url';

interface Props {
  layers: Project[];
  figIndex: (project: Project) => number;
}

const { layers, figIndex } = Astro.props;
---

<div class="harness-stack blueprint-panel">
  <CornerMarks />
  <div class="stack-head">
    <span class="dwg-tag">GROUP A</span>
    <span class="dwg-tag">{layers.length} LAYERS · ONE HARNESS</span>
  </div>

  <h3 class="stack-title">{harnessGroup.name}</h3>
  <p class="stack-headline">{harnessGroup.headline}</p>
  <p class="stack-intro">{harnessGroup.intro}</p>

  <ol class="layers">
    {layers.map((project, i) => (
      <li class="layer-item">
        <a class="layer" href={withBase(`/projects/${project.slug}/`)}>
          <div class="layer-id">
            <span class="layer-num">L{project.harnessLayer!.order}</span>
            <span class="layer-label">{project.harnessLayer!.label}</span>
            <span class="layer-question">{project.harnessLayer!.question}</span>
          </div>
          <div class="layer-body">
            <div class="layer-name-row">
              <span class="layer-name">{project.name}</span>
              <span class="layer-fig">FIG. {String(figIndex(project) + 1).padStart(2, '0')}</span>
            </div>
            <p class="layer-role">{project.harnessLayer!.role}</p>
            <p class="layer-value">{project.valueProps[0].headline}</p>
          </div>
          <div class="layer-stats">
            {project.stats.slice(0, 3).map((stat) => (
              <div class="stat">
                <span class="stat-value">{stat.value}</span>
                <span class="stat-label">{stat.label}</span>
              </div>
            ))}
          </div>
          <span class="layer-arrow" aria-hidden="true">→</span>
        </a>
        {i < layers.length - 1 && (
          <div class="connector" aria-hidden="true">
            <span class="connector-line"><span class="signal"></span></span>
            <span class="connector-label">{harnessGroup.connectors[i]}</span>
          </div>
        )}
      </li>
    ))}
  </ol>

  <p class="stack-note">{harnessGroup.note}</p>
</div>

<style>
  .harness-stack {
    padding: var(--space-lg);
    background:
      radial-gradient(ellipse 60% 50% at 100% 0%, rgba(61, 139, 255, 0.1), transparent 70%),
      radial-gradient(ellipse 50% 40% at 0% 100%, rgba(72, 215, 255, 0.07), transparent 70%),
      var(--color-bg-raised);
  }

  .stack-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-md);
  }

  .stack-title {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    width: fit-content;
    background: var(--gradient-ai);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stack-headline {
    color: var(--color-ink);
    font-size: 1.05rem;
    max-width: 60ch;
    margin-bottom: var(--space-sm);
  }

  .stack-intro {
    color: var(--color-ink-muted);
    font-size: 0.92rem;
    max-width: 78ch;
    margin-bottom: var(--space-lg);
  }

  .layers {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .layer {
    display: grid;
    grid-template-columns: 11rem 1fr auto 1.5rem;
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    position: relative;
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.3s ease;
  }

  /* Gradient spine on the left edge of each layer. */
  .layer::before {
    content: '';
    position: absolute;
    left: -1px;
    top: -1px;
    bottom: -1px;
    width: 3px;
    background: linear-gradient(to bottom, var(--color-cyan), var(--color-blue));
  }

  .layer:hover {
    background: var(--color-surface-hover);
    box-shadow: 0 10px 40px -20px rgba(61, 139, 255, 0.6);
  }

  .layer-id {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .layer-num {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1;
    background: var(--gradient-ai);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }

  .layer-label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .layer-question {
    font-size: 0.78rem;
    color: var(--color-amber);
  }

  .layer-name-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: 0.35rem;
  }

  .layer-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--color-ink);
  }

  .layer-fig {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-ink-faint);
  }

  .layer-role {
    color: var(--color-ink-muted);
    font-size: 0.88rem;
    line-height: 1.55;
    max-width: 62ch;
  }

  .layer-value {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-cyan);
  }

  .layer-value::before {
    content: '▸ ';
  }

  .layer-stats {
    display: flex;
    gap: var(--space-md);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 4.5rem;
  }

  .stat-value {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-cyan);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.68rem;
    color: var(--color-ink-faint);
    line-height: 1.3;
    max-width: 9rem;
  }

  .layer-arrow {
    color: var(--color-cyan);
    font-size: 1.1rem;
    transition: transform 0.2s ease;
  }

  .layer:hover .layer-arrow {
    transform: translateX(4px);
  }

  .connector {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    height: 2.6rem;
    padding-left: calc(var(--space-md) + 1.2rem);
  }

  .connector-line {
    position: relative;
    width: 1px;
    height: 100%;
    background: repeating-linear-gradient(to bottom, var(--color-line-strong) 0 4px, transparent 4px 8px);
    overflow: visible;
  }

  /* A signal dropping from one layer to the next. */
  .signal {
    position: absolute;
    left: -2px;
    top: 0;
    width: 5px;
    height: 12px;
    border-radius: 3px;
    background: linear-gradient(to bottom, transparent, var(--color-cyan), var(--color-blue));
    box-shadow: 0 0 10px var(--color-blue);
    animation: drop 2.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
  }

  li:nth-child(2) .signal {
    animation-delay: 1.1s;
  }

  @keyframes drop {
    0% { transform: translateY(-6px); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translateY(calc(2.6rem - 6px)); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal {
      animation: none;
      opacity: 0;
    }
  }

  .connector-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-faint);
  }

  .connector-label::before {
    content: '↕ ';
    color: var(--color-cyan);
  }

  .stack-note {
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-ink-faint);
    max-width: 90ch;
  }

  @media (max-width: 900px) {
    .harness-stack {
      padding: var(--space-md);
    }

    .stack-title {
      font-size: 1.6rem;
    }

    .layer {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .layer-id {
      flex-direction: row;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .layer-arrow {
      display: none;
    }

    .layer-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-sm);
    }

    .stat {
      min-width: 0;
    }
  }
</style>
