---
import { profile } from '../data/profile';
import ResumeDownloads from './ResumeDownloads.astro';
import NeuralField from './NeuralField.astro';
import SquadRoom from './SquadRoom.astro';
---

<section class="hero">
  <NeuralField />
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="sheet-label">Sfax, Tunisia — available for senior roles</p>
      <h1>
        Hamdi Jarboui builds <span class="ai-text">AI-agent systems</span> that ship real software, under human supervision.
      </h1>
      <p class="lede">{profile.summary}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#work">See the work</a>
        <ResumeDownloads />
      </div>
    </div>

    <div class="hero-replay">
      <p class="replay-caption">
        <span class="caption-dot" aria-hidden="true"></span>
        Watch an agent squad work a ticket, from claim to human-approved merge
      </p>
      <SquadRoom compact caseStudyLink />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, var(--space-2xl)) var(--space-xl);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-lg);
  }

  .hero-copy h1 {
    font-size: clamp(1.9rem, 4.6vw, 3.3rem);
    margin-block: var(--space-sm) var(--space-md);
    max-width: 19ch;
  }

  .lede {
    color: var(--color-ink-muted);
    font-size: 1.05rem;
    max-width: 60ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }

  .hero-copy,
  .hero-replay {
    min-width: 0;
  }

  .replay-caption {
    display: flex;
    align-items: center;
    gap: 0.55em;
    margin-bottom: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-ink-muted);
  }

  .caption-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gradient-ai);
    box-shadow: 0 0 10px rgba(61, 139, 255, 0.8);
    flex-shrink: 0;
  }

  @media (min-width: 1000px) {
    .hero {
      padding-block: clamp(2.5rem, 5vw, 4.5rem) var(--space-xl);
    }

    .hero-grid {
      grid-template-columns: 1fr 1.05fr;
      align-items: center;
      gap: var(--space-lg);
    }

    .hero-copy h1 {
      font-size: clamp(2.2rem, 3.3vw, 3rem);
      max-width: 22ch;
    }

    .lede {
      font-size: 1rem;
    }

    .hero-actions {
      margin-top: var(--space-md);
    }

    .hero-replay :global(.compact .channel) {
      height: 15.5rem;
    }
  }
</style>
