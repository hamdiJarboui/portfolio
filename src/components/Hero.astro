---
import { profile } from '../data/profile';
import ResumeDownloads from './ResumeDownloads.astro';
import NeuralField from './NeuralField.astro';
---

<section class="hero">
  <NeuralField />
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="sheet-label">Sfax, Tunisia — open to remote senior roles</p>
      <h1>
        Hamdi Jarboui builds <span class="ai-text">AI-agent systems</span> that ship real software, under human supervision.
      </h1>
      <p class="lede">{profile.summary}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#work">See the work</a>
        <a class="btn" href="#squad-demo">Watch the agent demo</a>
        <ResumeDownloads />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, var(--space-2xl)) var(--space-xl);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-lg);
  }

  .hero-copy h1 {
    font-size: clamp(1.9rem, 4.6vw, 3.3rem);
    margin-block: var(--space-sm) var(--space-md);
    max-width: 19ch;
  }

  .lede {
    color: var(--color-ink-muted);
    font-size: 1.05rem;
    max-width: 60ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }

  .hero-copy {
    min-width: 0;
  }

  @media (min-width: 1000px) {
    .hero-copy h1 {
      font-size: clamp(2.6rem, 4.2vw, 3.6rem);
      max-width: 24ch;
    }

    .lede {
      font-size: 1.1rem;
    }
  }
</style>
