---
import { harness } from '../data/harness';
---

<div class="harness">
  <p class="intro">{harness.intro}</p>

  <div class="tool-grid">
    {harness.groups.map((group) => (
      <div class="tool-card">
        <h3>{group.category}</h3>
        <p class="blurb">{group.blurb}</p>
        <ul class="chips">
          {group.tools.map((tool) => (
            <li>{tool}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <h3 class="sub-head">Guardrails</h3>
  <div class="guardrails">
    {harness.guardrails.map((item) => (
      <div class="guardrail">
        <h4>{item.headline}</h4>
        <p>{item.body}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .harness {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .intro {
    max-width: 70ch;
    color: var(--color-ink-muted);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .tool-card {
    background: var(--color-surface);
    padding: var(--space-md);
  }

  .tool-card h3 {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-cyan);
    margin-bottom: 0.6rem;
  }

  .blurb {
    font-size: 0.84rem;
    color: var(--color-ink-muted);
    margin-bottom: 0.9rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chips li {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-ink);
    padding: 0.25em 0.6em;
    border: 1px solid var(--color-line-strong);
  }

  .guardrails {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-md);
  }

  .sub-head {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-cyan);
  }

  .guardrail h4 {
    font-size: 0.9rem;
    margin-bottom: 0.35rem;
  }

  .guardrail p {
    font-size: 0.84rem;
    color: var(--color-ink-muted);
  }
</style>
