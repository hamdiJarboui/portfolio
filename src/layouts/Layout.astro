---
import '../styles/global.css';
import { withBase } from '../utils/url';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
  /** "website" for the home page, "article" for a case study. */
  type?: 'website' | 'article';
}

const { title, description, type = 'website' } = Astro.props;
const site = Astro.site ?? new URL('https://hamdijarboui.github.io');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(withBase('/og.png'), site).href;
const home = new URL(withBase('/'), site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  url: home,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Sfax', addressCountry: 'TN' },
  worksFor: { '@type': 'Organization', name: 'KPIT Technologies' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'ENETCOM, Sfax' },
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: ['Python', 'AI agents', 'Model Context Protocol', 'RAG', 'LLM automation', 'DevOps', 'CI/CD', 'Automotive software'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={withBase('/sitemap.xml')} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#0b1420" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Manrope:wght@400;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      // AI layer, progressive: without JS the page is the plain blueprint.
      const root = document.documentElement;
      root.classList.add('js');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Cursor spotlight on every blueprint panel (pointer devices only).
      if (window.matchMedia('(pointer: fine)').matches) {
        document.addEventListener(
          'pointermove',
          (e) => {
            const panel = (e.target as Element | null)?.closest?.('.blueprint-panel') as HTMLElement | null;
            if (!panel) return;
            const r = panel.getBoundingClientRect();
            panel.style.setProperty('--mx', `${e.clientX - r.left}px`);
            panel.style.setProperty('--my', `${e.clientY - r.top}px`);
          },
          { passive: true },
        );
      }

      // Scroll reveal for section heads, cards and layers.
      const targets = document.querySelectorAll<HTMLElement>(
        '.section-head, .blueprint-panel, .skill-card, .layer-item, .group-head, .rigor-row, .timeline-item',
      );
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        const siblingIndex = new Map<Element, number>();
        targets.forEach((el) => {
          const parent = el.parentElement;
          const i = parent ? siblingIndex.get(parent) ?? 0 : 0;
          if (parent) siblingIndex.set(parent, i + 1);
          el.style.setProperty('--reveal-delay', `${Math.min(i, 6) * 70}ms`);
          el.setAttribute('data-reveal', '');
          io.observe(el);
        });
      }
    </script>
  </body>
</html>
