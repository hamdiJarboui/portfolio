---
import '../styles/global.css';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      // AI layer, progressive: without JS the page is the plain blueprint.
      const root = document.documentElement;
      root.classList.add('js');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Cursor spotlight on every blueprint panel (pointer devices only).
      if (window.matchMedia('(pointer: fine)').matches) {
        document.addEventListener(
          'pointermove',
          (e) => {
            const panel = (e.target as Element | null)?.closest?.('.blueprint-panel') as HTMLElement | null;
            if (!panel) return;
            const r = panel.getBoundingClientRect();
            panel.style.setProperty('--mx', `${e.clientX - r.left}px`);
            panel.style.setProperty('--my', `${e.clientY - r.top}px`);
          },
          { passive: true },
        );
      }

      // Scroll reveal for section heads, cards and layers.
      const targets = document.querySelectorAll<HTMLElement>(
        '.section-head, .blueprint-panel, .skill-card, .layer-item, .group-head, .rigor-row, .timeline-item',
      );
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        const siblingIndex = new Map<Element, number>();
        targets.forEach((el) => {
          const parent = el.parentElement;
          const i = parent ? siblingIndex.get(parent) ?? 0 : 0;
          if (parent) siblingIndex.set(parent, i + 1);
          el.style.setProperty('--reveal-delay', `${Math.min(i, 6) * 70}ms`);
          el.setAttribute('data-reveal', '');
          io.observe(el);
        });
      }
    </script>
  </body>
</html>
