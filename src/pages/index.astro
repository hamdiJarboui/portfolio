---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import TeachingList from '../components/TeachingList.astro';
import Credentials from '../components/Credentials.astro';
import HarnessStack from '../components/HarnessStack.astro';
import { projects, type Project } from '../data/projects';

const harnessLayers = projects
  .filter((p) => p.harnessLayer)
  .sort((a, b) => a.harnessLayer!.order - b.harnessLayer!.order);
const otherWork = projects.filter((p) => !p.harnessLayer);
const figIndex = (project: Project) => projects.indexOf(project);
---

<Layout
  title="Hamdi Jarboui — Senior Python Engineer, AI Agents & DevOps"
  description="Senior Python engineer building AI-agent automation, DevOps pipelines, and full-stack systems — from AgileForge to a 549-tool MCP library."
>
  <Header />
  <main>
    <Hero />

    <section class="section" id="about">
      <div class="wrap">
        <div class="section-head">
          <p class="sheet-label">Sheet 01 — Capabilities</p>
          <h2>A full stack, from LLM agent to production pipeline</h2>
          <p>4+ years of Python depth applied to full-stack development, DevOps, and now AI-agent orchestration.</p>
        </div>
        <SkillsGrid />
      </div>
    </section>

    <section class="section" id="work">
      <div class="wrap">
        <div class="section-head">
          <p class="sheet-label">Sheet 02 — Selected work</p>
          <h2>An AI harness for the whole company, and the agentic systems around it</h2>
          <p>Every project here removes a real blocker to AI-assisted engineering: safety, cost, integration friction, tool lock-in or plain knowledge friction. I led each one from the first architecture decision to the running system, five of them as the only engineer.</p>
        </div>

        <div class="group-slot">
          <HarnessStack layers={harnessLayers} figIndex={figIndex} />
        </div>

        <div class="group-head">
          <span class="dwg-tag">GROUP B</span>
          <h3>Agentic delivery &amp; knowledge</h3>
          <p>Systems that put agents to work on real tickets, pull requests and documentation, with a human kept in control.</p>
        </div>
        <div class="featured-slot">
          <ProjectCard project={otherWork[0]} index={figIndex(otherWork[0])} featured={true} />
        </div>
        <div class="project-grid">
          {otherWork.slice(1).map((project) => (
            <ProjectCard project={project} index={figIndex(project)} />
          ))}
        </div>
      </div>
    </section>


    <section class="section" id="experience">
      <div class="wrap">
        <div class="section-head">
          <p class="sheet-label">Sheet 03 — Experience</p>
          <h2>Where this was built</h2>
        </div>
        <ExperienceTimeline />
      </div>
    </section>

    <section class="section" id="teaching">
      <div class="wrap">
        <div class="section-head">
          <p class="sheet-label">Sheet 04 — Teaching &amp; mentorship</p>
          <h2>5 years training engineers in Python and agentic AI</h2>
          <p>20-person cohorts, 10–30 hour programmes, 100% PCEP pass rate, students placing 3 times at national AI competitions.</p>
        </div>
        <TeachingList />
      </div>
    </section>

    <section class="section" id="credentials">
      <div class="wrap">
        <div class="section-head">
          <p class="sheet-label">Sheet 05 — Credentials</p>
          <h2>Certifications, education &amp; languages</h2>
        </div>
        <Credentials />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .group-slot {
    margin-bottom: var(--space-xl);
  }

  .group-head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-line);
  }

  .group-head h3 {
    font-size: 1.5rem;
  }

  .group-head p {
    color: var(--color-ink-muted);
    font-size: 0.92rem;
    max-width: 70ch;
  }

  .featured-slot {
    margin-bottom: var(--space-md);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 760px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
