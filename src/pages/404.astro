---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
import { withBase } from '../utils/url';
---

<Layout title="Page not found — Hamdi Jarboui" description="This page doesn't exist. Head back to the portfolio of Hamdi Jarboui, Senior Python Engineer — AI Agents & DevOps.">
  <Header />
  <main class="section">
    <div class="wrap not-found">
      <p class="sheet-label">Error 404 — Sheet not found</p>
      <h1>This page isn't on the drawing board.</h1>
      <p class="lede">The link may be old or mistyped. The work is still here:</p>
      <div class="actions">
        <a class="btn btn-primary" href={withBase('/')}>Back to the portfolio</a>
        <a class="btn" href={withBase('/#work')}>See the work</a>
      </div>
      <ul class="case-list">
        {projects.map((p) => (
          <li><a href={withBase(`/projects/${p.slug}/`)}>{p.name}</a></li>
        ))}
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .not-found h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-block: var(--space-sm) var(--space-md);
    max-width: 20ch;
  }

  .lede {
    color: var(--color-ink-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block: var(--space-md);
  }

  .case-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .case-list a {
    color: var(--color-cyan);
  }
</style>
